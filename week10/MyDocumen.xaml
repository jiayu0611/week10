<Window x:Class="week10.MyDocumen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:week10"
        mc:Ignorable="d"
        Title="MyDocumen" Height="450" Width="800">
    <DockPanel>
        <ToolBarTray Height="40" VerticalAlignment="Top" HorizontalAlignment="Left" DockPanel.Dock="Top" Background="Aqua">
            <ToolBar x:Name="ApplicationToolbar" Height="40" Width="400" Background="#FF94B4D8">
                <Button x:Name="NewButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/nwebutton.png"/> 
                </Button>
                <Button x:Name="OpenButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/openbutton.png"/>
                </Button>
                <Button x:Name="SaveButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/savebutton.png"/>
                </Button>
                <Button x:Name="trashButton" Height="38" Width="38">
                    <Image Height="32" Width="32" Source="/trashbutton.png"/>
                </Button>
            </ToolBar>
            <ToolBar x:Name="EditingToolbar" Height="40" Width="380" Background="#FFBCD8D8">
                
            </ToolBar>
        </ToolBarTray>
        <StatusBar Height="30" DockPanel.Dock="Bottom" Background="#FFD3C9E6"/>
        <RichTextBox x:Name="MainRichtexBox" Background="#FFA9BBAB">
            <FlowDocument/>
        </RichTextBox>
    </DockPanel>
</Window>
